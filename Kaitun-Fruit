local function commas(n)
	local str = tostring(n)
	local k
	repeat str, k = str:gsub("^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
	return str
end
local function getIcon(tex)
	local id = tostring(tex or ""):match("%d+")
	if not id then return nil end
	local ok, res = pcall(function()
		return HttpService:JSONDecode(game:HttpGet("https://thumbnails.roblox.com/v1/assets?assetIds=" .. id .. "&size=150x150&format=Png"))
	end)
	if ok and res and res.data and res.data[1] and res.data[1].imageUrl then
		return res.data[1].imageUrl
	end
	return "https://www.roblox.com/asset-thumbnail/image?assetId=" .. id .. "&width=150&height=150&format=png"
end
local httpReq = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)

-- Gửi JSON tới webhook, trả về (thành công, thông tin lỗi)
local function postJson(body)
	if not httpReq then return false, "executor không hỗ trợ request" end
	local ok, res = pcall(function()
		return httpReq({
			Url = SETTINGS.Webhook,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(body),
		})
	end)
	if not ok then return false, tostring(res) end
	local code = res and (res.StatusCode or res.status_code)
	if code and code >= 200 and code < 300 then return true, code end
	return false, "HTTP " .. tostring(code) .. " " .. tostring(res and res.Body or ""):sub(1, 80)
end

-- Gom các trái lụm trong cùng 1 server, gửi 1 tin duy nhất trước khi đổi server
local batch = {}
local batchFirst = nil
local function queueFruit(name, tex)
	local short = name:gsub(" Fruit$", "")
	batch[#batch + 1] = { name = name, tex = tex, price = FRUIT_PRICE[short] }
	batchFirst = batchFirst or tick()
end

local function flushBatch()
	if #batch == 0 then return end
	if not SETTINGS.Webhook or SETTINGS.Webhook == "" then batch = {}; batchFirst = nil; return end
	local items = batch
	batch = {}
	batchFirst = nil

	table.sort(items, function(x, y) return (x.price or 0) > (y.price or 0) end)
	local lines, total, unknown = {}, 0, false
	for _, it in ipairs(items) do
		if it.price then total += it.price else unknown = true end
		lines[#lines + 1] = ("• **%s** — %s"):format(it.name, it.price and (commas(it.price) .. " Beli") or "không rõ giá")
	end

	local embed = {
		title = ("🍎 Lụm được %d trái ác quỷ!"):format(#items),
		description = table.concat(lines, "\n"),
		color = 0xD4A55A,
		fields = {
			{ name = "Tài khoản", value = plr.Name, inline = true },
			{ name = "Số trái", value = tostring(#items), inline = true },
			{ name = "Tổng giá trị", value = commas(total) .. " Beli" .. (unknown and "+" or ""), inline = true },
		},
		footer = { text = "DTA HUB • " .. #Players:GetPlayers() .. " người trong server" },
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
	}
	-- ảnh: lấy icon của trái đắt nhất
	local icon = getIcon(items[1].tex)
	if icon then embed.thumbnail = { url = icon } end

	local ok, info = postJson({ username = "DTA HUB", embeds = { embed } })
	if not ok and icon then
		embed.thumbnail = nil
		ok, info = postJson({ username = "DTA HUB", embeds = { embed } })
	end
	if not ok then
		postJson({ content = ("🍎 **%s** lụm %d trái: %s"):format(plr.Name, #items, table.concat(lines, " | ")) })
	end
end

