-- Chụp danh sách tool hiện có, rồi chờ tool MỚI xuất hiện (không phụ thuộc tên)
local function toolSnapshot()
	local set = {}
	for _, container in ipairs({ plr.Backpack, plr.Character }) do
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") then set[t] = true end
			end
		end
	end
	return set
end
local function waitNewFruit(before, timeout)
	local t0 = tick()
	repeat
		for _, container in ipairs({ plr.Backpack, plr.Character }) do
			if container then
				for _, t in ipairs(container:GetChildren()) do
					if t:IsA("Tool") and not before[t] and (t.Name:find("Fruit") or t:FindFirstChild("EatRemote", true)) then
						return t
					end
				end
			end
		end
		task.wait(0.1)
	until tick() - t0 > timeout
	return nil
end

-- ========== Đổi server (tự viết, 3 lớp dự phòng, luôn có đường thoát) ==========
local HttpService = game:GetService("HttpService")
local hopping = false
local hopMsg = ""
local tpFailed = false
TeleportService.TeleportInitFailed:Connect(function() tpFailed = true end)

local function getServers()
	local list = {}
	-- Lớp 1: server browser của chính game Blox Fruits
	pcall(function()
		for _ = 1, 3 do
			local servers = RS.__ServerBrowser:InvokeServer(math.random(1, 30))
			for id, info in pairs(servers) do
				local c = tonumber(info.Count)
				if c and c < SETTINGS.MaxPlayers and id ~= game.JobId then list[#list + 1] = id end
			end
			if #list >= 10 then break end
		end
	end)
	-- Lớp 2: API Roblox
	if #list == 0 then
		pcall(function()
			local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
			local data = HttpService:JSONDecode(game:HttpGet(url))
			for _, sv in ipairs(data.data or {}) do
				if sv.playing and sv.playing < SETTINGS.MaxPlayers and sv.id ~= game.JobId then
					list[#list + 1] = sv.id
				end
			end
		end)
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

local function waitTeleport()
	tpFailed = false
	local t0 = tick()
	while not tpFailed and tick() - t0 < 10 do task.wait() end
end

local function hop()
	if hopping then return end
	hopping = true
	task.spawn(function()
		storeAll()
		flushBatch() -- gửi 1 tin gộp trước khi rời server
		local attempt = 0
		while true do
			attempt += 1
			hopMsg = ("đang tìm server (lần %d)..."):format(attempt)
			local list = getServers()
			for _, id in ipairs(list) do
				hopMsg = "đang vào server " .. tostring(id):sub(1, 6) .. " (" .. #list .. " server)"
				tpFailed = false
				pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, id, plr) end)
				waitTeleport()
			end
			-- Lớp 3: teleport ngẫu nhiên, luôn dùng được
			hopMsg = "teleport ngẫu nhiên..."
			tpFailed = false
			pcall(function() TeleportService:Teleport(game.PlaceId, plr) end)
			waitTeleport()
		end
	end)
end

-- ========== Vòng lặp chính ==========
task.spawn(function()
	repeat task.wait(0.2) until hasTeam() and getHRP()
	task.wait(0.5)
	local emptySince = nil

	while task.wait(0.1) do
		local ok, err = pcall(function()
			if hopping then status(hopMsg) return end
			-- 1) cất trái đang cầm
			if storeAll() > 0 then status("đã cất trái vào kho") end

			-- 2) tìm và nhặt trái
			local fruit = findFruit()
			if fruit then
				emptySince = nil
				local fname = fruit.Name
				local ftex = nil
				pcall(function() ftex = fruit.TextureId end)
				local before = toolSnapshot()
				status("bay tới " .. fname)
				flyTo(fruit)
				-- lụm được (có tool mới trong túi) thì báo Discord, chạy nền
				local got = waitNewFruit(before, 4)
				if got then
					status("đã lụm " .. fname)
					local tex = (ftex and ftex ~= "") and ftex or got.TextureId
					queueFruit(fname, tex)
				end
				task.wait(0.5)
				storeAll()
			else
				emptySince = emptySince or tick()
				local left = SETTINGS.WaitBeforeHop - (tick() - emptySince)
				status(string.format("không có trái (%.0fs)", math.max(left, 0)))
				if left <= 0 then hop() end
			end
		end)
		if not ok then warn("DTA:", err) end
	end
end)
