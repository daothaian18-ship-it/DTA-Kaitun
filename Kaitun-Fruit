	["Creation"]=1400000, ["Spider"]=1500000, ["Sound"]=1700000, ["Phoenix"]=1800000,
	["Portal"]=1900000, ["Rumble"]=2100000, ["Pain"]=2300000, ["Blizzard"]=2400000,
