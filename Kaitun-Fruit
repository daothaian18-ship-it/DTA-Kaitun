local function getHRP()
	local c = plr.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

-- ========== Tìm trái trên map ==========
local function findFruit()
	local hrp = getHRP()
	if not hrp then return nil end
	local best, bestD = nil, math.huge
	for _, v in ipairs(workspace:GetChildren()) do
		if v:IsA("Tool") and v.Name:find("Fruit") then
			local h = v:FindFirstChild("Handle")
			if h then
				local d = (h.Position - hrp.Position).Magnitude
				if d < bestD then best, bestD = v, d end
			end
		end
	end
	return best
end

local function flyTo(fruit)
	local hrp, hum = getHRP()
	if not hrp or not hum or hum.Health <= 0 then return end
	local h = fruit:FindFirstChild("Handle")
	if not h then return end

	flying = true
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = hrp

	local dist = (h.Position - hrp.Position).Magnitude
	local tween = TS:Create(hrp, TweenInfo.new(dist / SETTINGS.Speed, Enum.EasingStyle.Linear),
		{ CFrame = h.CFrame })
	tween:Play()
	local t0 = tick()
	while tween.PlaybackState == Enum.PlaybackState.Playing and fruit.Parent == workspace and tick() - t0 < 60 do
		-- cập nhật nếu trái bị di chuyển
		task.wait(0.1)
	end
	tween:Cancel()

	-- chạm vào trái để nhặt
	if fruit.Parent == workspace and h.Parent then
		for _ = 1, 10 do
			hrp.CFrame = h.CFrame
			pcall(function()
				if firetouchinterest then
					firetouchinterest(hrp, h, 0)
					firetouchinterest(hrp, h, 1)
				end
			end)
			task.wait(0.15)
			if fruit.Parent ~= workspace then break end
		end
	end
	bv:Destroy()
	flying = false
end

-- ========== Cất trái vào kho (kho đầy / lỗi thì bỏ qua, mỗi trái chỉ thử 1 lần) ==========
local tried = setmetatable({}, { __mode = "k" })
local function storeAll()
	local stored = 0
	local function try(tool)
		if tried[tool] then return end
		if tool:IsA("Tool") and tool:FindFirstChild("EatRemote", true) then
			tried[tool] = true
			local ok, res = pcall(function()
				return CommF:InvokeServer("StoreFruit", tool:GetAttribute("OriginalName") or tool.Name, tool)
			end)
			if ok and res then stored += 1 end
		end
	end
	for _, t in ipairs(plr.Backpack:GetChildren()) do try(t) end
	if plr.Character then
		for _, t in ipairs(plr.Character:GetChildren()) do try(t) end
	end
	return stored
end

